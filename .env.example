# Local dev: copy to `.env` and fill in.
# Railway: set the same keys in the service's "Variables" tab (no .env upload).
#
# Get keys from https://www.binance.com/ -> API Management
# (Testnet: https://testnet.binancefuture.com/)

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Set to "true" to actually place orders. Default is dry-run for safety.
LIVE_TRADING=false

# Set to "true" to use Binance Futures Testnet endpoints.
USE_TESTNET=false
